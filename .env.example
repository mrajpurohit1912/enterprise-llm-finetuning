# ==============================================================================
# Enterprise LLM Fine-Tuning - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace with your actual keys.
# NEVER commit your real .env file or API keys to version control.

# Hugging Face Access Token (Required for gated models and private datasets)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases Logging (Optional)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=enterprise-llm-finetuning

# Prometheus Metrics Telemetry
PROMETHEUS_PORT=8000

# Environment Mode (development | staging | production)
APP_ENV=development
